// Banner 与首页文章封面的低清占位图渐进过渡。
// 完整图片默认可见；仅在内联脚本成功执行时启用隐藏与 load 过渡，保证无 JS 时仍可使用。
.progressive-banner-image
  position absolute
  inset 0
  width 100%
  height 100%
  object-fit cover
  pointer-events none

.progressive-image-placeholder
  filter blur(28px)
  transform scale(1.08)

.progressive-image-full
  opacity 1
  filter none
  transform scale(1)

.progressive-images-js .progressive-image-full
  opacity 0
  filter blur(20px)
  transform scale(1.035)
  transition opacity .7s ease, filter .7s ease, transform .7s ease

.progressive-images-js .progressive-image-full.is-loaded
  opacity 1
  filter none
  transform scale(1)

#banner[data-progressive-banner]
  background-color var(--board-bg-color)

  > .full-bg-img
    position relative
    z-index 1
    width 100%
    height 100%

.progressive-index-image
  position relative
  display block
  width 100%
  height 10rem
  overflow hidden
  border-radius .25rem
  box-shadow 0 5px 11px 0 rgba(0, 0, 0, .18), 0 4px 15px 0 rgba(0, 0, 0, .15)

  .progressive-index-placeholder,
  .progressive-index-full
    position absolute
    inset 0
    display block
    width 100%
    height 100%
    object-fit cover
    border-radius 0
    box-shadow none

  .progressive-index-placeholder
    filter blur(24px)
    transform scale(1.08)

@media (prefers-reduced-motion: reduce)
  .progressive-images-js .progressive-image-full
    transition-duration 1ms
