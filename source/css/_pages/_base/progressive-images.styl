// Banner、首页文章封面及正文低清占位图的渐进过渡。
// 正文最终结构由 Hexo Build 直接生成，避免客户端把 img 替换成容器时重绘外框。
.fluid-lazy-image
  position relative
  display block
  margin 1.5rem auto
  overflow hidden
  background-color var(--body-bg-color)
  box-shadow 0 5px 11px 0 rgba(0, 0, 0, .18), 0 4px 15px 0 rgba(0, 0, 0, .15)
  border-radius 4px

  img
    border-radius 4px
    box-shadow none

  .img-blur
    position relative
    z-index 1
    display block
    opacity 0
    filter blur(32px)
    transition filter .7s

  .img-reveal-ready
    opacity 1
    filter blur(32px)

  .img-loaded
    opacity 1
    filter none

  .blur-loading
    position absolute
    z-index 0
    inset 0
    width 100%
    height 100%
    filter blur(32px)
    object-fit cover !important

// About 头像也会被正文图片处理器转换；恢复 Fluid 原本的圆形尺寸与阴影，
// 避免通用正文容器的 90% 宽度、方形背景和外边距暴露在头像下方。
.about-avatar .fluid-lazy-image
  width 100% !important
  max-width none !important
  height 100%
  margin 0
  overflow hidden
  border-radius 50%
  background-color transparent
  box-shadow 0 2px 5px 0 rgba(0, 0, 0, .16), 0 2px 10px 0 rgba(0, 0, 0, .12)

  img
    width 100%
    height 100%
    border-radius 50%
    object-fit cover
    box-shadow none

// 完整图片默认可见；仅在内联脚本成功执行时启用隐藏与 load 过渡，保证无 JS 时仍可使用。
.progressive-banner-image
  position absolute
  inset 0
  width 100%
  height 100%
  object-fit cover
  pointer-events none

.progressive-image-placeholder
  filter blur(32px)

.progressive-image-full
  opacity 1
  filter none

.progressive-images-js .progressive-image-full
  opacity 0
  filter blur(32px)
  transition filter .7s

// 与正文 .img-blur / .img-loaded 完全使用相同的显隐和滤镜规则。
// 客户端会等待 DOM 就绪及两个绘制帧后再添加此类，避免缓存图片跳过 transition。
.progressive-images-js .progressive-image-full.is-loaded
  opacity 1
  filter none

#banner[data-progressive-banner]
  background-color var(--board-bg-color)

  > .full-bg-img
    position relative
    z-index 1
    width 100%
    height 100%

.progressive-index-image
  position relative
  display block
  width 100%
  height 10rem
  overflow hidden
  border-radius .25rem
  background-color var(--body-bg-color)
  box-shadow 0 5px 11px 0 rgba(0, 0, 0, .18), 0 4px 15px 0 rgba(0, 0, 0, .15)

  .progressive-index-placeholder,
  .progressive-index-full
    position absolute
    inset 0
    display block
    width 100%
    height 100%
    object-fit cover
    border-radius 0
    box-shadow none

  .progressive-index-placeholder
    filter blur(32px)
