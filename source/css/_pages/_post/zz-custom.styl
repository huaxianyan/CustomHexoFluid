// 正文按钮：保留个人配色和阴影，其余尺寸沿用 Fluid 上游样式。
.markdown-body .btn
  vertical-align middle
  text-decoration none
  border-bottom none
  color var(--post-button-text-color)
  border-color var(--post-button-border-color)
  box-shadow 0 2px 4px rgba(0, 0, 0, .1)
  transition color .3s ease-out, background-color .3s ease-out, border-color .3s ease-out, box-shadow .3s ease-out

  &:hover
    color var(--post-button-text-color)
    border-color var(--post-button-hover-bg-color)
    background-color var(--post-button-hover-bg-color)
    box-shadow 0 4px 12px rgba(0, 0, 0, .15)

// Fold 标题和自定义箭头共同继承主题颜色，明暗切换与悬停均平滑过渡。
.markdown-body .fold-title
  cursor pointer
  transition color .3s ease-out

  &:hover
    color var(--link-hover-color)

.fold .fold-title .fold-arrow
  color inherit
  font-size 0
  transition transform .3s ease-out, color .3s ease-out

  &::before
    display inline-block
    color inherit
    font-size .75rem
    content "❯"
